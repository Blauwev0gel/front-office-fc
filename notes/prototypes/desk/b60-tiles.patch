+/* B60: the tiles-first desk */
+.tl-week{display:block;padding:4px 0 10px}.tl-week small{font:600 12px var(--body);color:var(--soft)}.tl-week small b.good{color:var(--good)}.tl-week small b.bad{color:var(--bad)}
+.tl-week h2{margin:2px 0 2px;font:italic 900 26px/1.08 var(--head);color:var(--acc)}.tl-week.crisis h2{color:var(--bad)}.tl-week p{margin:0;font:400 14px/1.35 var(--body);color:var(--soft)}
+.tl-grid{display:grid;grid-template-columns:1fr 1fr;gap:8px}
+.tl{position:relative;display:flex;flex-direction:column;gap:3px;min-height:104px;padding:12px;text-align:left;border:var(--l1);border-radius:14px;background:var(--paper);color:var(--ink);overflow:hidden}
