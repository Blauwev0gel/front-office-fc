+.tl-red{background:#7a1e2b;color:#fff;border-color:#4d0f19}.tl-red small,.tl-red em,.tl-red .tl-more{color:#f4e9d8}
+.tl-match{border-left:6px solid var(--acc)}
+.tl-ask{font:700 14px var(--body)!important;font-style:normal!important;color:var(--bad)}
+.tl-moods{display:flex!important;gap:10px;-webkit-line-clamp:unset!important;margin-top:4px}.tl-moods span{display:inline-flex;align-items:center;gap:1px}.tl-moods svg{width:20px;height:20px}.tl-moods .lo{color:var(--bad)}
+.tl-sub{font-size:13px!important;color:var(--soft)}
+.tl-list{display:flex;flex-direction:column;gap:6px}.tl-li{display:flex;gap:10px;align-items:flex-start;padding:10px;border:var(--l1);border-radius:12px;background:var(--paper)}
+.tl-li .rbf{flex:none;width:36px;height:36px;border-radius:50%;overflow:hidden;display:grid;place-items:center}.tl-li .rbf svg{width:100%;height:100%}.tl-li .rbf.ic svg{width:22px;height:22px}
+.tl-li p{margin:0;font:400 14px/1.35 var(--body)}.tl-li small{display:block;font:600 11px var(--body);color:var(--soft)}.tl-li b{display:block}
