+
+/* the weekly desk (UX-1) */
+.dk-week{padding:2px 0 4px}.dk-week small{font:600 12px var(--body);color:var(--soft);letter-spacing:.02em}.dk-week small b{font-weight:700}.dk-week small b.good{color:var(--good)}.dk-week small b.bad{color:var(--bad)}
