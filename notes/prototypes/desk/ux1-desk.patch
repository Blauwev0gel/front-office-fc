+.dk-more{display:flex;flex-wrap:wrap;gap:4px 14px;justify-content:center;margin:12px 0 4px}.dk-more .linkbtn{min-height:44px}
+.dk-back{min-height:44px}.dk-back svg{transform:rotate(180deg)}.dk-fh h2{margin:4px 0 8px;font:italic 900 24px var(--head)}
